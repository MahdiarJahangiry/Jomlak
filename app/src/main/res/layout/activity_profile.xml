<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/grey"
    android:layout_height="match_parent"
    tools:context=".activity.Profile">

    <include layout="@layout/content_tolbar_layer"/>



    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:scrollbars="none"
        android:layout_marginBottom="100dp"
        android:layout_marginTop="140dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content">


            <RelativeLayout
                android:layout_width="130dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:layout_height="130dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_centerInParent="true"
                    android:layout_height="120dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_person_pin_24"
                        android:scaleType="centerCrop"
                        android:layout_height="wrap_content"/>


                    <ImageView
                        android:layout_width="match_parent"
                        android:id="@+id/img_proile"
                        android:scaleType="centerCrop"
                        android:layout_height="match_parent"/>


                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="30dp"
                    app:cardCornerRadius="15dp"
                    android:id="@+id/add_img"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    app:cardBackgroundColor="@color/red"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:src="@drawable/ic_baseline_add_24"
                        android:layout_height="match_parent"/>

                </androidx.cardview.widget.CardView>


            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_code"
                        android:textSize="16sp"
                        android:text="@string/code_davat"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/ed_code"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_username"
                        android:textSize="16sp"
                        android:text="@string/username"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_username"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_email"
                        android:textSize="16sp"
                        android:text="@string/email"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_email"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content">

                        <Button
                            android:layout_width="wrap_content"
                            android:backgroundTint="@color/teal_400"
                            android:id="@+id/btnUpdateEmail"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:text="@string/update"
                            android:layout_height="wrap_content"/>

                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:id="@+id/edtCodeEmail"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:inputType="number"
                            android:hint="@string/code_email"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/black"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>



                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_display_name"
                        android:textSize="16sp"
                        android:text="@string/name"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_display_name"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_pass"
                        android:textSize="16sp"
                        android:text="@string/password"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_pass"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="textPassword"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_name"
                        android:textSize="16sp"
                        android:text="@string/name_optinal"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_name"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_sure_name"
                        android:textSize="16sp"
                        android:text="@string/family_optinal"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_sure_name"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_date"
                        android:textSize="16sp"
                        android:text="@string/date_optinal"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_date"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_age"
                        android:textSize="16sp"
                        android:text="@string/age_optinal"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/edt_age"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:inputType="number"
                        android:maxLength="3"
                        android:layout_height="55dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="6dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="15dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:id="@+id/txt_gender"
                        android:textSize="16sp"
                        android:text="@string/gender_optinal"
                        android:layout_marginBottom="2dp"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="15dp"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="0.4"
                            android:gravity="center|left"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:id="@+id/radio_1"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/men"
                                android:id="@+id/txt_man"
                                android:layout_marginLeft="-10dp"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="0.5"
                            android:gravity="center"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:id="@+id/radio_2"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/women"
                                android:id="@+id/txt_women"
                                android:layout_marginLeft="-10dp"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:gravity="center|right"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:id="@+id/radio_3"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/not_sure"
                                android:id="@+id/txt_sure"
                                android:layout_marginLeft="-10dp"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>




            <Button
                android:layout_width="match_parent"
                android:backgroundTint="@color/teal_400"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                android:id="@+id/btn_update"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:text="@string/edit"
                android:layout_height="60dp"/>

            <Button
                android:layout_width="match_parent"
                android:id="@+id/txt_logout"
                android:backgroundTint="@color/purple_500"
                android:visibility="visible"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="15dp"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="@string/logout_menu"
                android:layout_height="60dp"/>



        </LinearLayout>


    </androidx.core.widget.NestedScrollView>



</RelativeLayout>