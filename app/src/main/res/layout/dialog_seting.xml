<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:id="@+id/re_up"
    android:layoutDirection="ltr"
    android:layout_height="wrap_content">


    <include layout="@layout/content_tolbar_layer" />




    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="15dp"
        android:gravity="center"
        android:layout_height="match_parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/txt_vlome"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:text="@string/vloum"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/seekbar"
                android:max="10"
                android:layout_marginLeft="5dp"
                android:layout_height="wrap_content"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center|left"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:textColor="@color/black"
                android:id="@+id/txt_talker"
                android:textSize="18sp"
                android:text="@string/talker"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:id="@+id/checkbox"
                android:checked="true"
                android:layout_height="wrap_content"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center|left"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:textColor="@color/black"
                android:id="@+id/txt_music"
                android:textSize="18sp"
                android:text="@string/music"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:id="@+id/checkbox_music"
                android:checked="true"
                android:layout_height="wrap_content"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:textSize="16sp"
                android:text="انتخاب موزیک:"
                android:layout_height="wrap_content"/>

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/spinner_music"
                android:layout_marginTop="2dp"
                android:spinnerMode="dropdown"
                android:background="@drawable/spinner_learning"
                android:layout_height="58dp"/>

        </LinearLayout>

    </LinearLayout>



</RelativeLayout>