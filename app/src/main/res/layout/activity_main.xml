<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/white">

    <!-- لوگو (پنهان) -->
    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/logo"
        android:visibility="gone" />

    <!-- تولبار -->
    <include layout="@layout/content_tolbar" />

    <!-- تصویر پس‌زمینه پایین -->
    <ImageView
        android:layout_width="260dp"
        android:layout_height="290dp"
        android:layout_alignParentBottom="true"
        android:src="@drawable/ui" />

    <!-- 🆕 دکمه ربات جملک - گوشه بالا راست -->
    <LinearLayout
        android:id="@+id/li_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/re_tolbar"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="#4CAF50"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 ربات"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- دکمه ثبت‌نام -->
    <LinearLayout
        android:id="@+id/li_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_co"
            android:layout_width="65dp"
            android:layout_height="25dp"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="-15dp"
            android:src="@drawable/seke_200" />

        <ImageView
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/sigin_icon" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/register_main"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- دکمه پخش (مرکز صفحه) -->
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/newplay1" />

        <TextView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_centerInParent="true"
            android:background="@drawable/back_play_fade_main" />

        <ImageView
            android:id="@+id/img_play"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="75dp"
            android:layout_marginLeft="75dp"
            android:src="@drawable/seyfplay1" />
    </RelativeLayout>

    <!-- دکمه ویدیو (گوشه بالا راست زیر تولبار) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/re_tolbar"
        android:layout_alignParentRight="true"
        android:layout_marginTop="60dp"
        android:layout_marginRight="15dp"
        android:gravity="center|right"
        android:orientation="vertical">

        <TextView
            android:id="@+id/img_video"
            android:layout_width="100dp"
            android:layout_height="58dp"
            android:background="@drawable/video_icon"
            android:gravity="left|center"
            android:paddingTop="5dp"
            android:paddingLeft="10dp"
            android:textColor="@color/white"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- نوار پایین -->
    <LinearLayout
        android:id="@+id/li_buttom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E6FCFCFC"
        android:gravity="center"
        android:padding="15dp">

        <LinearLayout
            android:id="@+id/li_frinds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/frind_icon"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_frinds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/frinds_main"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- دکمه فروشگاه (اگر دارید) -->
        <LinearLayout
            android:id="@+id/li_ads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"

                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>

    <!-- منوی پایین -->
    <include layout="@layout/content_menu" />

</RelativeLayout>