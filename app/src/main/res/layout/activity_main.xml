<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/white"
    tools:ignore="Overdraw">


    <!-- لوگو (پنهان) -->

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/back_main" />

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/logo"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <!-- تولبار -->


    <include layout="@layout/content_tolbar" />


    <!-- تصویر پس‌زمینه پایین -->

    <!-- دکمه ربات جملک - گوشه بالا راست -->
    <LinearLayout
        android:id="@+id/li_bot"
        android:layout_width="96dp"
        android:layout_height="51dp"
        android:layout_below="@+id/re_tolbar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"

        android:background="@drawable/longbtn"
        android:clickable="true"
        android:contentDescription="ربات"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="10dp"
        tools:ignore="HardcodedText,TextContrastCheck,ImageContrastCheck">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="🤖 ربات"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>



    <!-- دکمه پخش (مرکز صفحه) -->
    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/back_play_fade_main" />

        <ImageView
            android:id="@+id/img_play"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_centerInParent="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/seyfplay1"
            tools:ignore="ContentDescription" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/re_tolbar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="65dp"
        android:layout_marginEnd="15dp"
        android:gravity="center|end"
        android:orientation="vertical">

    </LinearLayout>

    <!-- نوار پایین -->

    <!-- منوی پایین -->

    <LinearLayout
        android:id="@+id/li_buttom"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"

        android:gravity="center"
        android:padding="15dp">

        <LinearLayout
            android:id="@+id/li_frinds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/frind_icon"
                android:visibility="visible"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/txt_frinds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/frinds_main"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- دکمه فروشگاه / تبلیغات -->
        <LinearLayout
            android:id="@+id/li_ads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:clickable="true"
            android:contentDescription="تبلیغات"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            tools:ignore="HardcodedText">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:visibility="visible"
                tools:ignore="ContentDescription" />

        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/content_menu" />

    <ImageView
        android:id="@+id/TitleImage"
        android:layout_width="320dp"
        android:layout_height="285dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="47dp"
        android:layout_marginTop="48dp"
        app:srcCompat="@drawable/title" />

    <TextView
        android:id="@+id/img_video"
        android:layout_width="92dp"
        android:layout_height="62dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="95dp"
        android:background="@drawable/video_icon"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:textColor="@color/white"
        android:textSize="22sp"
        tools:ignore="RtlSymmetry,TextContrastCheck" />


</RelativeLayout>
