<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/re_up"
    android:layoutDirection="ltr"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:gravity="center|bottom"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/li_coin"
            android:visibility="invisible"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txt_coin"
                android:text="+8"
                android:textColor="@color/teal_400"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="21dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/img_coin" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:background="@drawable/back_cricle"
                android:backgroundTint="@color/pink_400"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:id="@+id/liCoinCambo"
                android:layout_marginStart="15dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txt_cambo"
                    android:text="+8"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="21dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/img_coin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/cambo"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"/>


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/darbaremaboxseyf"
            android:gravity="center"
            android:layout_height="75dp">

            <TextView
                android:layout_width="match_parent"
                android:gravity="center"
                android:visibility="gone"
                android:id="@+id/txt_end_level"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginTop="15dp"
                android:text="برنده شدی"
                android:layout_height="wrap_content"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="65dp"
                    android:id="@+id/img_back"
                    android:src="@drawable/prevseyf"
                    android:layout_height="65dp"/>

                <ImageView
                    android:layout_width="65dp"
                    android:id="@+id/img_report"
                    android:src="@drawable/reportseyf"
                    android:layout_height="65dp"/>


                <RelativeLayout
                    android:layout_width="65dp"
                    android:id="@+id/img_share"
                    android:layout_height="65dp">

                    <ImageView
                        android:layout_width="65dp"
                        android:src="@drawable/shareseyf"
                        android:layout_centerInParent="true"
                        android:layout_height="65dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="5dp"
                        android:visibility="gone"
                        android:paddingRight="5dp"
                        android:layout_centerInParent="true"
                        android:layout_alignParentBottom="true"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="4dp"
                            android:src="@drawable/img_coin" />


                    </LinearLayout>

                </RelativeLayout>



                <ImageView
                    android:layout_width="65dp"
                    android:id="@+id/img_next"
                    android:src="@drawable/nextseyf"
                    android:layout_height="65dp"/>

            </LinearLayout>


        </LinearLayout>


    </LinearLayout>






</RelativeLayout>