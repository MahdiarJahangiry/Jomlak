<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/re_up"
    android:layoutDirection="ltr"
    android:layout_height="match_parent">

    <include layout="@layout/content_tolbar_layer" />



    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center"
        android:background="@drawable/darbaremaboxseyf"
        android:layout_height="400dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_marginRight="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="20dp"
            android:shadowColor="@color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:textAllCaps="true"
            android:id="@+id/txt_about"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:text=""
            android:layout_weight="1"
            android:layout_height="0dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="30dp"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="50dp"
                android:id="@+id/card_telegram"
                android:layout_marginRight="10dp"
                app:cardCornerRadius="4dp"
                app:cardBackgroundColor="@color/purple_500"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_telegram_plane_icon"
                    android:layout_height="wrap_content"/>


            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="50dp"
                android:id="@+id/card_insta"
                android:layout_marginRight="10dp"
                app:cardCornerRadius="4dp"
                app:cardBackgroundColor="@color/purple_500"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_instagram_icon"
                    android:layout_height="wrap_content"/>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="50dp"
                android:id="@+id/card_phone"
                android:layout_marginRight="10dp"
                app:cardCornerRadius="4dp"
                app:cardBackgroundColor="@color/purple_500"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_local_phone_icon"
                    android:layout_height="wrap_content"/>


            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="50dp"
                android:id="@+id/card_email"
                app:cardCornerRadius="4dp"
                app:cardBackgroundColor="@color/purple_500"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_email_letter_mail_message_icon"
                    android:layout_height="wrap_content"/>


            </androidx.cardview.widget.CardView>


        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:id="@+id/txt_version"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginBottom="30dp"
            android:layout_height="wrap_content"/>



    </LinearLayout>




</RelativeLayout>