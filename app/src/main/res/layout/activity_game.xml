<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/re_back"
    android:background="@color/grey_100"
    android:layoutDirection="ltr"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="wrap_content"
        android:src="@drawable/logo"
        android:visibility="gone"
        android:id="@+id/img_logo"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/re_blur"
        android:orientation="vertical"
        android:layout_height="match_parent">



    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="horizontal"
        android:layout_marginRight="11dp"
        android:layout_marginLeft="15dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/linear_answer"
        android:layout_marginBottom="70dp"
        android:layout_height="wrap_content">




    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/re_word"
        android:layout_height="match_parent">


        <com.game.education.model.LineView
            android:id="@+id/line_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <TextView
            android:id="@+id/btn_1"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_above="@+id/btn_2"
            android:layout_centerInParent="true"
            android:layout_marginBottom="40dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="ali"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_2"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_above="@+id/btn_3"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="45dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="reza"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_3"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginRight="10dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="reza"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_4"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginTop="45dp"
            android:layout_below="@+id/btn_3"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginRight="30dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="reza"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_5"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_centerInParent="true"
            android:layout_marginTop="40dp"
            android:layout_below="@id/btn_4"
            android:layout_marginLeft="15dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="mohammad"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_6"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginTop="45dp"
            android:layout_below="@+id/btn_7"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginLeft="30dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="reza"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_7"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginLeft="10dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="mohammad"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/btn_8"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_above="@+id/btn_7"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginLeft="30dp"
            android:layout_marginBottom="45dp"
            android:background="@drawable/word_un_select"
            android:gravity="center"
            tools:text="reza"
            android:textColor="@color/black"
            android:textSize="15sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:id="@+id/viewHint"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/btn_hint"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="55dp"
                    android:id="@+id/img_hint"
                    android:layout_height="55dp"
                    android:src="@drawable/exir8967"
                    android:visibility="visible" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="-8dp"
                    android:background="@drawable/exir435"
                    android:gravity="center"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-25"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="4dp"
                        android:src="@drawable/img_coin" />




                </LinearLayout>


            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/btnMagnet"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/magnet"/>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/exir435"
                    android:gravity="center"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-25"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="4dp"
                        android:src="@drawable/img_coin" />




                </LinearLayout>


            </LinearLayout>



        </LinearLayout>


        <RelativeLayout
            android:layout_width="55dp"
            android:id="@+id/btn_change"
            android:layout_above="@+id/viewHint"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/change_icon"
            android:layout_height="55dp"/>



    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginBottom="95dp"
        android:layout_height="wrap_content">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:id="@+id/scrollView"
            android:scrollbars="none"
            android:layout_height="70dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="15dp"
                android:gravity="center"
                android:id="@+id/linear_show_answer"
                android:layout_height="wrap_content">





            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/re_tolbar"
        android:layout_height="wrap_content">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layoutDirection="ltr"
            android:id="@+id/tol_coin"
            android:gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="15dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:src="@drawable/back_icon" />

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_centerInParent="true"
                android:layout_alignParentRight="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="40dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/li_ads"
                    android:layout_centerInParent="true"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txt_coin"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="200"
                        android:textColor="@color/black"
                        android:textSize="22sp" />

                    <ImageView
                        android:id="@+id/img_coin"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="4dp"
                        android:src="@drawable/coinssstseyf2" />




                </LinearLayout>

            </androidx.cardview.widget.CardView>





        </RelativeLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:id="@+id/gift"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/tol_coin"
            android:layout_marginStart="15dp"
            app:lottie_rawRes="@raw/gift"
            app:lottie_autoPlay="false"
            app:lottie_speed="0.5"
            app:lottie_loop="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:id="@+id/li_video"
            android:gravity="center|right"
            android:layout_below="@+id/tol_coin"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_height="wrap_content">


            <TextView
                android:layout_width="100dp"
                android:layout_height="58dp"
                android:textSize="22sp"
                android:gravity="left|center"
                android:textColor="@color/white"
                android:paddingTop="5dp"
                android:paddingLeft="10dp"
                android:id="@+id/img_video"
                android:background="@drawable/video_icon" />


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:id="@+id/txt_level"
            android:textSize="16sp"
            android:layoutDirection="ltr"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"
            android:layout_height="wrap_content"/>



    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:id="@+id/txt_check"
        android:layout_below="@+id/re_tolbar"
        android:visibility="invisible"
        android:layout_centerInParent="true"
        android:paddingRight="15dp"
        android:paddingLeft="15dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/word_un_select"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_height="wrap_content"/>


    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="110dp"
        android:gravity="center"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            app:cardCornerRadius="4dp"
            android:visibility="gone"
            android:id="@+id/card_ads"
            app:cardBackgroundColor="@color/white"
            android:layout_height="50dp">

            <ImageView
                android:layout_width="match_parent"
                android:scaleType="centerCrop"
                android:layout_gravity="center"
                android:id="@+id/img_ads"
                android:layout_height="match_parent"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:textColor="@color/black"
            android:id="@+id/txt_ads"
            android:textSize="13sp"
            android:maxLines="1"
            android:visibility="gone"
            android:textStyle="bold"
            android:text="@string/app_name"
            android:layout_height="wrap_content"/>


    </LinearLayout>






</RelativeLayout>